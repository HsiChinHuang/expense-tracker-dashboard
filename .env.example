# ============================================================
# Environment Variables — copy to .env and fill in
# DO NOT commit .env (contains secrets)
# ============================================================

# --- Required ---
PLATFORM=github
API_TOKEN=your_token_here
REPO_ID=owner/repo

# --- Optional ---
# API_URL=                          # self-hosted only
#   GitHub default: https://api.github.com
#   GitLab default: https://gitlab.com/api/v4

# --- Launcher 控制 ---
# LAUNCHER_AUTO_RESTART=true        # 崩潰後是否自動重啟
# LAUNCHER_MAX_RESTART_ATTEMPTS=10  # 0 = 不限制
# ORCH_SCHEDULED_RESTART=false      # Orchestrator 排程重啟
# ORCH_RESTART_HOURS=1
# ORCH_RESTART_TRANSITIONS=20

# --- Slots ---
# MAX_SLOTS=3

# ============================================================
# REPO_ID accepted formats (auto-normalized by scripts/platform.ts):
#   1. owner/repo
#   2. https://github.com/owner/repo
#   3. https://github.com/owner/repo.git
#   4. git@github.com:owner/repo.git
# All four resolve to the same {owner, repo}.
#
# PLATFORM=gitlab uses the same formats (with a GitLab host).
# ============================================================

# ============================================================
# NOTE: GIT_ASKPASS and GIT_TERMINAL_PROMPT are set
# programmatically by the Launcher. Do NOT define them here.
# See docs/commands.md § Git Credentials.
# ============================================================

# ============================================================
# Application variables (requirements/Chapter3_TechStack.md §3.10)
# Placeholders / documented defaults only — never commit real secrets.
# ============================================================

# --- Backend (FastAPI) ---
DATABASE_URL=sqlite:///./dev.db
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ISSUER=expense-tracker
JWT_AUDIENCE=expense-tracker-api
CORS_ORIGINS=["http://localhost:5173"]
ENVIRONMENT=development
APP_VERSION=1.0.0
DB_CONNECT_TIMEOUT=5

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- MCP server ---
MCP_API_BASE_URL=http://localhost:8000/api/v1
MCP_JWT_SECRET=${JWT_SECRET}