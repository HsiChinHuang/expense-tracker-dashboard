{
  "uid": "expense-tracker",
  "title": "Expense Tracker",
  "description": "Phase 13 operational board for the expense tracker: the three questions the t76 alert set poses - is expense creation working, is it failing, and is the database fallback latch engaged. Metric names belong to observability/alerts.yaml (t76); this board visualises every declared name and invents none.",
  "tags": [
    "expense-tracker",
    "phase-13",
    "t77"
  ],
  "timezone": "utc",
  "editable": true,
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "datasource": {
    "type": "prometheus",
    "uid": "prometheus-local"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Expense creation rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(expense_created_total[5m]))",
          "legendFormat": "expense creations per second"
        },
        {
          "refId": "B",
          "expr": "sum(rate(category_created_total[5m]))",
          "legendFormat": "category creations per second"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Creation failure rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(expense_create_failures_total[5m]))",
          "legendFormat": "creation failures per second"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Database fallback state",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "db_fallback_active",
          "legendFormat": "fallback latch (1 = serving from fallback)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    }
  ]
}
